---
interface Props {
	name: string;
	price: string;
	image?: string;
}

const { name, price, image } = Astro.props;
---

<div class="featured-card">
	<div class="card-image-wrapper">
		{
			image ? (
				<img src={image} alt={name} class="card-image" />
			) : (
				<div class="card-placeholder" />
			)
		}
	</div>
	<div class="card-info">
		<h3 class="card-title">{name}</h3>
		<p class="card-price">desde {price}</p>
	</div>
</div>

<style>
	.featured-card {
		display: flex;
		flex-direction: column;
		width: 100%;
	}

	/* Asegura un contenedor cuadrado e idéntico para todas las fotos */
	.card-image-wrapper {
		width: 100%;
		aspect-ratio: 1 / 1;
		overflow: hidden;
		background-color: #FAFAFA;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 8px;
	}

	/* Rena todas las fotos para que tengan exacto el mismo tamaño visual */
	.card-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		display: block;
	}

	.card-placeholder {
		width: 100%;
		height: 100%;
		background-color: #EEE;
	}

	.card-info {
		margin-top: 12px;
	}

	.card-title {
		font-size: 16px;
		font-weight: 500;
		margin: 0 0 4px 0;
	}

	.card-price {
		font-size: 14px;
		color: var(--color-text-secondary, #666);
		margin: 0;
	}
</style>