---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FeaturedCard from "../components/FeaturedCard.astro";
import { buildWaLink, DEFAULT_MESSAGE } from "../lib/whatsapp";
import { FEATURED_PRODUCTS } from "../data/products";

const waLink = buildWaLink(DEFAULT_MESSAGE);
---

<Layout title="Los Abuelos — Piñatas hechas a mano">
	<Header currentPage="inicio" />

	<main id="main-content">
	<section class="hero">
		<div class="hero-image">
			<img
				src="/images/logonew.png"
				alt="Piñata Los Abuelos — El arte cobrando vida"
				loading="eager"
			/>
		</div>
		<p class="eyebrow">Piñatas a la medida</p>
		<h1>Piñatas hechas a mano, para fiestas que se recuerdan</h1>
		<p class="lead">
			Diseñamos y armamos cada pieza en nuestro taller, a partir del tema de
			tu celebración. Del boceto a la fiesta, todo bajo un mismo techo.
		</p>
		<div class="cta-row">
			<a href="/catalogo" class="btn btn-outline">Ver catálogo</a>
			<a href={waLink} target="_blank" rel="noopener" class="btn btn-solid"
				>Pedir por WhatsApp</a
			>
		</div>
	</section>

	<section class="featured">
		<div class="featured-header">
			<h2>Piezas destacadas</h2>
			<a href="/catalogo" class="see-all">Ver todo el catálogo →</a>
		</div>
		<div class="featured-grid">
			{
				FEATURED_PRODUCTS.map((item) => (
					<FeaturedCard
						name={item.name}
						price={item.price}
						image={item.image}
					/>
				))
			}
		</div>
	</section>

	<section class="editorial editorial-purple">
		{/* Cargamos la imagen directamente de la carpeta public/images/ */}
		<div class="editorial-image-container">
			<img
				src="/images/pinata6.png"
				alt="Piñata personaje a medida"
				class="editorial-image"
			/>
		</div>
		<div class="editorial-text">
			<p class="eyebrow">Diseño a la medida</p>
			<h2>Cuéntanos el tema. Nosotros la hacemos realidad.</h2>
			<p class="body-text">
				Trabajamos contigo el diseño de tu piñata: personaje, tamaño, colores
				y detalles. Cada pieza se corta, pega y pinta a mano, con tiempos de
				entrega que te avisamos desde el primer mensaje.
			</p>
			<a href={waLink} target="_blank" rel="noopener" class="underline-link"
				>Empezar mi pedido</a
			>
		</div>
	</section>

	<section class="editorial editorial-reverse editorial-bee">
		<div class="editorial-text">
			<p class="eyebrow eyebrow-bee">Decoración completa</p>
			<h2>Más allá de la piñata</h2>
			<p class="body-text">
				Globos, centros de mesa y ambientación a juego con el tema de tu
				piñata, para que la fiesta se vea completa de principio a fin.
			</p>
			<a href="/contacto" class="underline-link link-bee">Cotizar decoración</a>
		</div>
		<div class="editorial-image-container flex-image-full">
			<img
				src="/images/pinata2x1.png"
				alt="Piñata Abejita y Número 1"
				class="editorial-image-full"
			/>
		</div>
	</section>

	<section class="cta-band">
		<h2>¿Ya tienes la fecha?</h2>
		<p>
			Escríbenos con el tema, la fecha y el tamaño que buscas. Te respondemos
			con opciones y precio el mismo día.
		</p>
		<a href={waLink} target="_blank" rel="noopener" class="btn btn-cta-band"
			>Pedir por WhatsApp</a
		>
	</section>
	</main>

	<Footer />
</Layout>

<style>
	.hero {
		position: relative;
		padding: clamp(60px, 12vh, 120px) var(--section-px);
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 28px;
	}
	.hero-image {
		width: 100%;
		max-width: 1400px;
		background: transparent;
	}
	.hero-image img {
		width: 100%;
		max-width: min(650px, 90vw);
		height: auto;
		display: block;
		margin: 0 auto;
		background: transparent !important;
	}
	.hero h1 {
		font-size: clamp(36px, 5.5vw, 64px);
		line-height: 1.1;
		max-width: 820px;
	}
	.hero .lead {
		max-width: 560px;
		font-size: 17px;
		line-height: 1.7;
		color: var(--color-text-secondary);
	}
	.cta-row {
		display: flex;
		gap: 16px;
		flex-wrap: wrap;
		justify-content: center;
		margin-top: 8px;
	}

	.featured {
		padding: 40px var(--section-px) 100px;
	}
	.featured-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 36px;
		flex-wrap: wrap;
	}
	.featured-header h2 {
		font-size: clamp(26px, 3vw, 36px);
	}
	.see-all {
		font-size: 14px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.featured-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 28px;
	}

	.editorial {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0;
	}
	.editorial-purple {
		background: var(--color-accent-3);
	}
	.editorial-purple .eyebrow {
		color: var(--color-text);
	}
	.editorial-purple .underline-link {
		color: var(--color-text);
		border-bottom-color: var(--color-text);
	}

	/* Sección de la Abeja */
	.editorial-bee {
		background-color: #F9F8F6;
	}
	.editorial-reverse .editorial-text {
		order: 1;
	}
	.editorial-reverse .flex-image-full {
		order: 2;
	}
	.editorial-text {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 20px;
		padding: clamp(32px, 6vw, 72px);
	}
	.editorial-text h2 {
		font-size: clamp(26px, 3vw, 34px);
		line-height: 1.25;
	}
	.body-text {
		font-size: 16px;
		line-height: 1.8;
		color: var(--color-text-secondary);
		max-width: 480px;
	}
	.underline-link {
		font-size: 14px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		border-bottom: 1px solid var(--color-accent);
		padding-bottom: 4px;
		width: fit-content;
	}

	/* Colores de acento amarillo abeja */
	.eyebrow-bee {
		color: #E29B12 !important;
		font-weight: 600;
	}
	.link-bee {
		color: #E29B12 !important;
		border-bottom-color: #E29B12 !important;
	}

	/* Estilos generales para contenedores de imagen */
	.editorial-image-container {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 24px;
		box-sizing: border-box;
	}
	.editorial-image {
		width: 100%;
		max-height: 480px;
		object-fit: contain;
		display: block;
	}

	/* Imagen en tamaño grande extendida */
	.flex-image-full {
		padding: 0;
		background: #F9F8F6;
		min-height: 420px;
	}
	.editorial-image-full {
		width: 100%;
		height: 100%;
		min-height: 420px;
		object-fit: cover;
		object-position: center;
		display: block;
	}

	.cta-band {
		padding: clamp(60px, 10vh, 100px) var(--section-px);
		text-align: center;
		background: var(--color-accent);
		color: var(--color-on-accent);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
	}
	.cta-band h2 {
		font-size: clamp(28px, 3.4vw, 40px);
	}
	.cta-band p {
		max-width: 480px;
		font-size: 16px;
		line-height: 1.7;
		opacity: 0.9;
	}
	.btn-cta-band {
		background: var(--color-on-accent);
		color: var(--color-accent);
		padding: 14px 32px;
		font-size: 14px;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		margin-top: 8px;
	}
	.btn-cta-band:hover {
		color: var(--color-accent-hover);
	}

	@media (max-width: 720px) {
		.editorial {
			grid-template-columns: 1fr;
		}
		.editorial-reverse .editorial-text {
			order: 0;
		}
		.editorial-reverse .flex-image-full {
			order: 0;
			min-height: 320px;
		}
	}
</style>