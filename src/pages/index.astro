---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PlaceholderImage from "../components/PlaceholderImage.astro";
import FeaturedCard from "../components/FeaturedCard.astro";
import { buildWaLink, DEFAULT_MESSAGE } from "../lib/whatsapp";
import { FEATURED_PRODUCTS } from "../data/products";

const waLink = buildWaLink(DEFAULT_MESSAGE);
---

<Layout title="Los Abuelos — Piñatas hechas a mano">
	<Header currentPage="inicio" />

	<section class="hero">
		<div class="hero-image">
			<PlaceholderImage
				label="foto: piñata hecha a mano, taller Los Abuelos"
				aspectRatio="16/7"
				stripeWidth={16}
			/>
		</div>
		<p class="eyebrow">Piñatas a la medida</p>
		<h1>Piñatas hechas a mano, para fiestas que se recuerdan</h1>
		<p class="lead">
			Diseñamos y armamos cada pieza en nuestro taller, a partir del tema de
			tu celebración. Del boceto a la fiesta, todo bajo un mismo techo.
		</p>
		<div class="cta-row">
			<a href="/catalogo" class="btn btn-outline">Ver catálogo</a>
			<a href={waLink} target="_blank" rel="noopener" class="btn btn-solid"
				>Pedir por WhatsApp</a
			>
		</div>
	</section>

	<section class="featured">
		<div class="featured-header">
			<h2>Piezas destacadas</h2>
			<a href="/catalogo" class="see-all">Ver todo el catálogo →</a>
		</div>
		<div class="featured-grid">
			{
				FEATURED_PRODUCTS.map((item) => (
					<FeaturedCard name={item.name} price={item.price} />
				))
			}
		</div>
	</section>

	<section class="editorial editorial-purple">
		<PlaceholderImage
			label="foto: taller, artesano pintando piñata"
			aspectRatio="1"
			stripeColor1="#BA8CBE"
			stripeColor2="#9C93E5"
			stripeWidth={16}
			textColor="oklch(0.98 0.01 40)"
			padding="24px"
		/>
		<div class="editorial-text">
			<p class="eyebrow">Diseño a la medida</p>
			<h2>Cuéntanos el tema. Nosotros la hacemos realidad.</h2>
			<p class="body-text">
				Trabajamos contigo el diseño de tu piñata: personaje, tamaño, colores
				y detalles. Cada pieza se corta, pega y pinta a mano, con tiempos de
				entrega que te avisamos desde el primer mensaje.
			</p>
			<a href={waLink} target="_blank" rel="noopener" class="underline-link"
				>Empezar mi pedido</a
			>
		</div>
	</section>

	<section class="editorial editorial-reverse">
		<div class="editorial-text">
			<p class="eyebrow">Decoración completa</p>
			<h2>Más allá de la piñata</h2>
			<p class="body-text">
				Globos, centros de mesa y ambientación a juego con el tema de tu
				piñata, para que la fiesta se vea completa de principio a fin.
			</p>
			<a href="/contacto" class="underline-link">Cotizar decoración</a>
		</div>
		<PlaceholderImage
			label="foto: mesa decorada a juego con la piñata"
			aspectRatio="1"
			stripeWidth={16}
			padding="24px"
		/>
	</section>

	<section class="cta-band">
		<h2>¿Ya tienes la fecha?</h2>
		<p>
			Escríbenos con el tema, la fecha y el tamaño que buscas. Te respondemos
			con opciones y precio el mismo día.
		</p>
		<a href={waLink} target="_blank" rel="noopener" class="btn btn-cta-band"
			>Pedir por WhatsApp</a
		>
	</section>

	<Footer />
</Layout>

<style>
	.hero {
		position: relative;
		padding: clamp(60px, 12vh, 120px) var(--section-px);
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 28px;
	}
	.hero-image {
		width: 100%;
		max-width: 1200px;
	}
	.hero h1 {
		font-size: clamp(36px, 5.5vw, 64px);
		line-height: 1.1;
		max-width: 820px;
	}
	.hero .lead {
		max-width: 560px;
		font-size: 17px;
		line-height: 1.7;
		color: var(--color-text-secondary);
	}
	.cta-row {
		display: flex;
		gap: 16px;
		flex-wrap: wrap;
		justify-content: center;
		margin-top: 8px;
	}

	.featured {
		padding: 40px var(--section-px) 100px;
	}
	.featured-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 36px;
		flex-wrap: wrap;
	}
	.featured-header h2 {
		font-size: clamp(26px, 3vw, 36px);
	}
	.see-all {
		font-size: 14px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.featured-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 28px;
	}

	.editorial {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0;
	}
	.editorial-purple {
		background: var(--color-accent-3);
	}
	.editorial-reverse .editorial-text {
		order: 1;
	}
	.editorial-reverse :global(.placeholder) {
		order: 2;
	}
	.editorial-text {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 20px;
		padding: clamp(32px, 6vw, 72px);
	}
	.editorial-text h2 {
		font-size: clamp(26px, 3vw, 34px);
		line-height: 1.25;
	}
	.body-text {
		font-size: 16px;
		line-height: 1.8;
		color: var(--color-text-secondary);
		max-width: 480px;
	}
	.underline-link {
		font-size: 14px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		border-bottom: 1px solid var(--color-accent);
		padding-bottom: 4px;
		width: fit-content;
	}

	.cta-band {
		padding: clamp(60px, 10vh, 100px) var(--section-px);
		text-align: center;
		background: var(--color-accent);
		color: var(--color-on-accent);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
	}
	.cta-band h2 {
		font-size: clamp(28px, 3.4vw, 40px);
	}
	.cta-band p {
		max-width: 480px;
		font-size: 16px;
		line-height: 1.7;
		opacity: 0.9;
	}
	.btn-cta-band {
		background: var(--color-on-accent);
		color: var(--color-accent);
		padding: 14px 32px;
		font-size: 14px;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		margin-top: 8px;
	}
	.btn-cta-band:hover {
		color: var(--color-accent-hover);
	}

	@media (max-width: 720px) {
		.editorial {
			grid-template-columns: 1fr;
		}
		.editorial-reverse .editorial-text {
			order: 0;
		}
		.editorial-reverse :global(.placeholder) {
			order: 0;
		}
	}
</style>
